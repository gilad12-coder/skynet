# Skynet Frontend Configuration
# Copy to .env.local: cp .env.example .env.local

# Backend API URL
# ⚠️  Use HTTPS in production to protect API keys and auth tokens!
# Development:
# Still respected as a build-time default; `API_URL` (set on the running
# pod, see runtime section below) takes precedence in production images.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Production example:
# NEXT_PUBLIC_API_URL=https://api.example.com

# Public site origin — inlined into robots.txt, sitemap.xml, OpenGraph and
# canonical URLs at build time, so it cannot be changed on a prebuilt image.
# When unset or empty it defaults to the public https://skynetml.com.
# NEXT_PUBLIC_SITE_URL=https://app.example.com

# Hosted web app origin. The Mac app share notice links to its /login page.
# When unset or empty it defaults to https://skynetml.com.
# NEXT_PUBLIC_HOSTED_APP_URL=https://skynetml.com

# ── Runtime env (server-side, runtime-overridable per pod) ──
# These values are read by the Next.js server at request time and injected
# into `window.__APP_ENV__` so a single built image can be pointed at
# any backend by setting these env vars on the pod (no rebuild needed).
# When unset, the build-time `NEXT_PUBLIC_*` defaults above are used.
API_URL=http://localhost:8000
APP_VERSION=0.1.0

# ── Optional error reporting (Sentry) ──
# Leave unset to disable all Sentry delivery. The public values are embedded at
# build time for browser reporting; the private DSN covers the Next.js server.
# SENTRY_DSN=https://public-key@o0.ingest.sentry.io/0
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.05
# NEXT_PUBLIC_SENTRY_DSN=https://public-key@o0.ingest.sentry.io/0
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.05

# ── NextAuth ──
# Generate a fresh secret: openssl rand -base64 32
AUTH_SECRET=change-me-in-production
# Local dev only: set a distinct value per checkout when running two Skynet
# frontends on localhost, or their session cookies overwrite each other.
# AUTH_COOKIE_PREFIX=app-dev
# Shared with the backend. Generate a separate strong value and set the same
# value in the backend environment so admin API calls can be verified.
BACKEND_AUTH_SECRET=change-me-in-production

# ── Sign-in (social + email/password) ──
# Each social provider appears on the login screen only when BOTH its id and
# secret are set; email/password ("create an account in Skynet") always works
# and is verified by the backend over BACKEND_AUTH_SECRET. Identity is the email
# for every provider. AUTH_ADMINS grants the admin role to those emails on any
# provider. See AUTH_SETUP.md for step-by-step OAuth
# app creation and the exact redirect URIs to register.
#
# Google — https://console.cloud.google.com  (APIs & Services → Credentials)
#   Authorized redirect URI: http://localhost:3000/api/auth/callback/google
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
#
# GitHub — https://github.com/settings/developers  (New OAuth App)
#   Authorization callback URL: http://localhost:3000/api/auth/callback/github
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=
#
# AUTH_ADMINS=admin@example.com

# Without OAuth configured, the login page offers email/password
# accounts ("create an account"), verified against the backend /auth routes
# over BACKEND_AUTH_SECRET. There is no auth-off mode.

# ── Feature flags ──
# Generalist agent panel (Cmd/Ctrl+J). Unset: on in dev, off in prod.
# Accepts: 1, true, on, yes
# NEXT_PUBLIC_FEATURE_GENERALIST_AGENT=1

# AI co-tagging assist in the tagger (interview / co-pilot / autopilot).
# Unset: on. Set to 0 to ship the fully manual tagger.
# NEXT_PUBLIC_FEATURE_TAGGER_ASSIST=1
