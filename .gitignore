!.claude/commands/
!.claude/skills/
.claude/skills/*
!.claude/skills/skynet-pr-workflow
!.claude/skills/skynet-test-accounts
CLAUDE.md
!/CLAUDE.md
!/frontend/CLAUDE.md

# Jupyter
.ipynb_checkpoints/

# OS files
.DS_Store

# Playwright
.playwright-mcp/

# Screenshots
*.png
