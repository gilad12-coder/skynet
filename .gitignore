codedb.snapshot
.tmp_buggy_conversation.txt
.helm-out.yml
backend/load_tests/results/
frontend/perf-results/
logs/
*.log
*.pid

# Operator artefacts produced by scripts/airgap_migrate.sh
/migration.sql
/deploy/helm/skynet/values-airgap.generated.yaml

