# Environment variables (NEVER commit secrets)
.env
.env.local
!.env.example
*.db

# Build artifacts
.next/
.ruff_cache/
.benchmarks/
node_modules/
*.tsbuildinfo

# Agents/tools. Locally installed skills stay out of git; the shared
